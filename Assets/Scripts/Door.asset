  dialogues:
  - speaker: 6
    dialogueText: "Oh! A visitor. How unexpected\u2026 and rather inconvenient."
    choicesTexts: []
    answersIndexes: 
    dialogueEnd: 0
    eventName: MEET_DOOR
  - speaker: 6
    dialogueText: "I do hope you haven\u2019t come expecting to simply walk through.
      That would be most improper."
    choicesTexts: []
    answersIndexes: 
    dialogueEnd: 0
    eventName: 
  - speaker: 6
    dialogueText: "If you wish to pass, you\u2019ll need to present the proper\u2026
      something. I cannot open for just anyone, you understand."
    choicesTexts:
    - '[KEY]'
    - '[!]'
    - I don't have it...
    answersIndexes: 05000000060000000a000000
    dialogueEnd: 0
    eventName: 
  - speaker: 6
    dialogueText: Back already? How persistent.
    choicesTexts: []
    answersIndexes: 
    dialogueEnd: 0
    eventName: 
